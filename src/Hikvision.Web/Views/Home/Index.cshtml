@model Hikvision.Web.ViewModels.Home.DashboardViewModel
@using Hikvision.Web.ViewModels.Home
@{
    ViewData["Title"] = "لوحة التحكم";

    void RenderCard(string title, string color, string icon, List<DashboardEmpRow> rows)
    {
        <div class="card table-card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi @icon text-@color"></i> @title</span>
                <span class="badge bg-@color">@rows.Count</span>
            </div>
            @if (rows.Count == 0)
            {
                <div class="card-body text-muted small">لا يوجد</div>
            }
            else
            {
                <div class="table-responsive" style="max-height:340px;overflow:auto">
                    <table class="table table-sm table-hover mb-0">
                        <thead><tr><th>الموظف</th><th>المجموعة</th><th>تفاصيل</th></tr></thead>
                        <tbody>
                            @foreach (var r in rows)
                            {
                                <tr><td>@r.Name</td><td>@r.GroupName</td><td class="text-muted small">@r.Detail</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    void StatCard(string label, int value, string soft, string icon)
    {
        <div class="col-md-3 col-6">
            <div class="card stat-card">
                <div class="stat-icon @soft"><i class="bi @icon"></i></div>
                <div>
                    <div class="stat-label">@label</div>
                    <div class="stat-value">@value</div>
                </div>
            </div>
        </div>
    }
}

<p class="text-muted">تقارير يوم @Model.Today.ToString("yyyy-MM-dd")</p>

<div class="row g-3 mb-4">
    @{ StatCard("إجمالي الموظفين", Model.EmployeeCount, "bg-soft-primary", "bi-people"); }
    @{ StatCard("الحاضرون اليوم", Model.PresentToday.Count, "bg-soft-success", "bi-check2-circle"); }
    @{ StatCard("المتغيبون اليوم", Model.AbsentToday.Count, "bg-soft-danger", "bi-x-circle"); }
    @{ StatCard("المتأخرون اليوم", Model.LateToday.Count, "bg-soft-warning", "bi-alarm"); }
</div>

<div class="row">
    <div class="col-lg-6">@{ RenderCard("الحاضرون اليوم", "success", "bi-check2-circle", Model.PresentToday); }</div>
    <div class="col-lg-6">@{ RenderCard("المتغيبون اليوم", "danger", "bi-x-circle", Model.AbsentToday); }</div>
    <div class="col-lg-6">@{ RenderCard("المتأخرون اليوم", "warning", "bi-alarm", Model.LateToday); }</div>
    <div class="col-lg-6">@{ RenderCard("ما زالوا بالداخل (دخول دون خروج)", "info", "bi-door-open", Model.StillInside); }</div>
    <div class="col-lg-12">@{ RenderCard("موظفون بلا أي سجل خلال 30 يومًا", "secondary", "bi-person-dash", Model.NoRecord30Days); }</div>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-arrow-repeat"></i> آخر مزامنة مع الجهاز</div>
    <div class="card-body">
        @if (Model.LastSync is null)
        {
            <p class="text-muted mb-0">لم تُجرَ أي مزامنة بعد. <a asp-controller="Sync" asp-action="Index">ابدأ المزامنة الآن</a>.</p>
        }
        else
        {
            <ul class="mb-0">
                <li>الحالة: @(Model.LastSync.Success ? "نجحت" : "فشلت")</li>
                <li>الفترة: @Model.LastSync.FromTime.ToString("yyyy-MM-dd HH:mm") إلى @Model.LastSync.ToTime.ToString("yyyy-MM-dd HH:mm")</li>
                <li>مُدخل: @Model.LastSync.InsertedCount — مكرر: @Model.LastSync.SkippedDuplicateCount</li>
            </ul>
        }
    </div>
</div>

