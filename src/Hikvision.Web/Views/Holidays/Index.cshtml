@model IEnumerable<Holiday>
@{
    ViewData["Title"] = "الإجازات الرسمية";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الإجازات الرسمية</h2>
    <a asp-action="Create" class="btn btn-primary">+ إضافة إجازة</a>
</div>
<p class="text-muted">تُحتسب أيام هذه الإجازات حضورًا لجميع الموظفين في تقرير المرتبات.</p>

<div class="card table-card"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead>
        <tr><th>الوصف</th><th>من</th><th>إلى</th><th>عدد الأيام</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>@h.Description</td>
                <td>@h.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@h.EndDate.ToString("yyyy-MM-dd")</td>
                <td>@(h.EndDate.DayNumber - h.StartDate.DayNumber + 1)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@h.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                    <form asp-action="Delete" asp-route-id="@h.Id" method="post" class="d-inline" onsubmit="return confirm('تأكيد حذف الإجازة؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div></div>
@if (!Model.Any())
{
    <p class="text-muted mt-2">لا توجد إجازات مسجّلة.</p>
}
