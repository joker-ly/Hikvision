@model IEnumerable<Employee>
@{
    ViewData["Title"] = "الموظفون";
    var sort = ViewBag.Sort as string ?? "name";
    var search = ViewBag.Search as string;
    var nameSort = sort == "name" ? "name_desc" : "name";
    var nameArrow = sort == "name" ? "▲" : sort == "name_desc" ? "▼" : "";
    var finSort = sort == "financial" ? "financial_desc" : "financial";
    var finArrow = sort == "financial" ? "▲" : sort == "financial_desc" ? "▼" : "";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الموظفون</h2>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">+ إضافة موظف</a>
        @if (Model.Any())
        {
            <form asp-action="DeleteAll" method="post" class="d-inline"
                  onsubmit="return confirm('سيتم حذف جميع الموظفين وسجلات حضورهم نهائيًا. هل أنت متأكد؟');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">🗑 حذف الكل</button>
            </form>
        }
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="ImportFromDevice" method="post" class="row g-2 align-items-end"
              onsubmit="return confirm('سيتم استيراد الأشخاص المسجّلين على الجهاز إلى المجموعة المختارة. متابعة؟');">
            <div class="col-md-4">
                <label class="form-label">استيراد الموظفين من الجهاز إلى مجموعة</label>
                <select name="groupId" asp-items="ViewBag.Groups" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-primary">⬇ استيراد من الجهاز</button>
            </div>
            <div class="col-12">
                <small class="text-muted">يجلب الأشخاص المسجّلين على الجهاز (بأرقامهم وأسمائهم) وينشئ الجدد فقط؛ الموجودون مسبقًا يُتخطّون.</small>
            </div>
        </form>
    </div>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3" style="max-width:560px;">
    <input type="hidden" name="sort" value="@sort" />
    <div class="col">
        <input type="search" name="search" value="@search" class="form-control"
               placeholder="بحث بالرقم المالي أو الاسم أو رقم الجهاز" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> بحث</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(search))
    {
        <div class="col-auto">
            <a asp-action="Index" asp-route-sort="@sort" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    }
</form>

<div class="card table-card">
<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead>
        <tr>
            <th><a asp-action="Index" asp-route-sort="@nameSort" asp-route-search="@search" class="text-decoration-none text-reset">الاسم @nameArrow</a></th>
            <th>رقم الجهاز</th>
            <th><a asp-action="Index" asp-route-sort="@finSort" asp-route-search="@search" class="text-decoration-none text-reset">الرقم المالي @finArrow</a></th>
            <th>المجموعة</th>
            <th>الراتب الأساسي</th>
            <th>نشط</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.FullName</td>
                <td><span class="badge bg-soft-secondary">@e.DeviceEmployeeNo</span></td>
                <td>@(string.IsNullOrEmpty(e.FinancialNo) ? "—" : e.FinancialNo)</td>
                <td>@e.Group?.Name</td>
                <td>@(e.BaseSalary?.ToString("N2") ?? "—")</td>
                <td>@(e.IsActive ? Html.Raw("<span class='badge bg-soft-success'>نعم</span>") : Html.Raw("<span class='badge bg-soft-danger'>لا</span>"))</td>
                <td class="page-actions">
                    <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary" title="تعديل"><i class="bi bi-pencil"></i></a>
                    <a asp-controller="ManualAttendance" asp-action="Create" asp-route-employeeId="@e.Id" target="_blank" class="btn btn-sm btn-outline-success" title="إدخال يدوي"><i class="bi bi-pencil-square"></i></a>
                    <a asp-controller="Attendance" asp-action="Index" asp-route-employeeId="@e.Id" class="btn btn-sm btn-outline-info" title="سجلات الحضور"><i class="bi bi-card-checklist"></i></a>
                    <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline" onsubmit="return confirm('تأكيد حذف الموظف؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
