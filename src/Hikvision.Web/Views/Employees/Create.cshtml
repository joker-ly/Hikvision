@model Employee
@{
    ViewData["Title"] = "إضافة موظف";
}
<h2>إضافة موظف</h2>
<form asp-action="Create" method="post" class="mt-3" style="max-width:650px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DeviceEmployeeNo" class="form-label"></label>
        <input asp-for="DeviceEmployeeNo" class="form-control" />
        <span asp-validation-for="DeviceEmployeeNo" class="text-danger"></span>
        <div class="form-text">يجب أن يطابق رقم الموظف المسجّل على الجهاز.</div>
    </div>
    <div class="mb-3">
        <label asp-for="EmployeeGroupId" class="form-label">المجموعة</label>
        <select asp-for="EmployeeGroupId" asp-items="ViewBag.Groups" class="form-select"></select>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="NationalId" class="form-label"></label>
            <input asp-for="NationalId" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="BaseSalary" class="form-label"></label>
            <input asp-for="BaseSalary" type="number" step="0.01" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="HireDate" class="form-label"></label>
            <input asp-for="HireDate" type="date" class="form-control" />
        </div>
        <div class="col-md-6 mb-3 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">حفظ</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
