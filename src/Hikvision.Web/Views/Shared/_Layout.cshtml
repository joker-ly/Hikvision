@using System.Security.Claims
@using Hikvision.Web.Models.Enums
@inject Hikvision.Web.Services.Auth.IPermissionService Perms
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(params string[] controllers) =>
        controllers.Any(c => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var isAuth = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · نظام الحضور والمرتبات</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (!isAuth)
{
    <main class="auth-wrap">
        @RenderBody()
    </main>
}
else
{
    <div class="app">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <i class="bi bi-fingerprint"></i>
                <span>الحضور والمرتبات</span>
                <button type="button" class="btn btn-sm btn-dark d-lg-none ms-auto sidebar-close"><i class="bi bi-x-lg"></i></button>
            </div>
            <nav class="sidebar-nav">
                @if (await Perms.CanViewAsync(AppModule.Dashboard))
                {
                    <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> لوحة التحكم</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Groups) || await Perms.CanViewAsync(AppModule.Schedules) ||
                     await Perms.CanViewAsync(AppModule.Employees) || await Perms.CanViewAsync(AppModule.Holidays))
                {
                    <div class="nav-section">إدارة</div>
                }
                @if (await Perms.CanViewAsync(AppModule.Groups))
                {
                    <a class="nav-link @Active("Groups")" asp-controller="Groups" asp-action="Index"><i class="bi bi-diagram-3"></i> المجموعات</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Schedules))
                {
                    <a class="nav-link @Active("Schedules")" asp-controller="Schedules" asp-action="Index"><i class="bi bi-clock-history"></i> مواعيد الدوام</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Employees))
                {
                    <a class="nav-link @Active("Employees")" asp-controller="Employees" asp-action="Index"><i class="bi bi-people"></i> الموظفون</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Holidays))
                {
                    <a class="nav-link @Active("Holidays")" asp-controller="Holidays" asp-action="Index"><i class="bi bi-calendar-event"></i> الإجازات الرسمية</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Attendance) || await Perms.CanViewAsync(AppModule.ManualAttendance) ||
                     await Perms.CanViewAsync(AppModule.Sync))
                {
                    <div class="nav-section">الحضور</div>
                }
                @if (await Perms.CanViewAsync(AppModule.Attendance))
                {
                    <a class="nav-link @Active("Attendance")" asp-controller="Attendance" asp-action="Index"><i class="bi bi-card-checklist"></i> سجلات الحضور</a>
                }
                @if (await Perms.CanViewAsync(AppModule.ManualAttendance))
                {
                    <a class="nav-link @Active("ManualAttendance")" asp-controller="ManualAttendance" asp-action="Create"><i class="bi bi-pencil-square"></i> إدخال يدوي</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Sync))
                {
                    <a class="nav-link @Active("Sync")" asp-controller="Sync" asp-action="Index"><i class="bi bi-arrow-repeat"></i> المزامنة مع الجهاز</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Payroll) || await Perms.CanViewAsync(AppModule.Statistics) ||
                     await Perms.CanViewAsync(AppModule.Audit) || await Perms.CanViewAsync(AppModule.Settings) ||
                     await Perms.CanViewAsync(AppModule.Users))
                {
                    <div class="nav-section">تقارير ونظام</div>
                }
                @if (await Perms.CanViewAsync(AppModule.Payroll))
                {
                    <a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Payroll"><i class="bi bi-bar-chart"></i> تقرير المرتبات</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Statistics))
                {
                    <a class="nav-link" asp-controller="Reports" asp-action="Statistics"><i class="bi bi-graph-up"></i> الإحصائيات</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Audit))
                {
                    <a class="nav-link @Active("Audit")" asp-controller="Audit" asp-action="Index"><i class="bi bi-shield-check"></i> سجل العمليات</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Settings))
                {
                    <a class="nav-link @Active("Settings")" asp-controller="Settings" asp-action="Device"><i class="bi bi-gear"></i> الإعدادات</a>
                }
                @if (await Perms.CanViewAsync(AppModule.Users))
                {
                    <a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i> المستخدمون</a>
                }
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-light d-lg-none" type="button" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="topbar-title">@ViewData["Title"]</h1>
                <div class="topbar-user dropdown">
                    <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i>
                        <span class="d-none d-sm-inline">@(User.FindFirstValue("DisplayName") ?? User.Identity?.Name)</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-start">
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> تسجيل الخروج</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main class="app-content">
                @if (TempData["Success"] is string ok)
                {
                    <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle"></i> @ok<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (TempData["Error"] is string err)
                {
                    <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle"></i> @err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var sb = document.getElementById('appSidebar');
            var bd = document.getElementById('sidebarBackdrop');
            if (!sb) return;
            function open() { sb.classList.add('open'); bd.classList.add('show'); }
            function close() { sb.classList.remove('open'); bd.classList.remove('show'); }
            var t = document.getElementById('sidebarToggle');
            if (t) t.addEventListener('click', open);
            if (bd) bd.addEventListener('click', close);
            document.querySelectorAll('.sidebar-close').forEach(function (b) { b.addEventListener('click', close); });
            sb.querySelectorAll('.nav-link').forEach(function (l) { l.addEventListener('click', close); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
