@model IEnumerable<EmployeeGroup>
@{
    ViewData["Title"] = "مجموعات التوظيف";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>مجموعات التوظيف</h2>
    <a asp-action="Create" class="btn btn-primary">+ إضافة مجموعة</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>الاسم</th>
            <th>الوصف</th>
            <th>مقيّد بمواعيد الدوام</th>
            <th>طريقة الاحتساب</th>
            <th>عدد الموظفين</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td>@g.Name</td>
                <td>@g.Description</td>
                <td>@(g.IsTimeBound ? "نعم" : "لا (بصمة دخول تكفي)")</td>
                <td>@(g.CalculationMode == CalculationMode.ByWorkHours ? "بعدد ساعات العمل" : "بأوقات الحضور والانصراف")</td>
                <td>@g.Employees.Count</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                    <a asp-controller="Schedules" asp-action="Edit" asp-route-groupId="@g.Id" class="btn btn-sm btn-outline-info">المواعيد</a>
                    <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline" onsubmit="return confirm('تأكيد حذف المجموعة؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
