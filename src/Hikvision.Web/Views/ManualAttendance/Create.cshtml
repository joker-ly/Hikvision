@model Hikvision.Web.ViewModels.ManualAttendance.ManualEntryViewModel
@{
    ViewData["Title"] = "إدخال سجل حضور يدوي";
}
<h2>إدخال سجل حضور يدوي</h2>
<p class="text-muted">يُوثَّق هذا السجل بوضوح كـ "يدوي" مع نوعه وسببه، ويُميَّز عن سجلات الجهاز.</p>

<form asp-action="Create" method="post" class="mt-3" style="max-width:650px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label"></label>
        <select asp-for="EmployeeId" asp-items="ViewBag.Employees" class="form-select">
            <option value="">— اختر —</option>
        </select>
        <span asp-validation-for="EmployeeId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ManualType" class="form-label"></label>
        <select asp-for="ManualType" class="form-select">
            <option value="@((int)ManualAttendanceType.WorkMission)">مهمة عمل</option>
            <option value="@((int)ManualAttendanceType.Leave)">إجازة</option>
            <option value="@((int)ManualAttendanceType.PermittedExit)">خروج بإذن</option>
            <option value="@((int)ManualAttendanceType.TaskDone)">إنجاز عمل</option>
        </select>
        <span asp-validation-for="ManualType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EventTime" class="form-label"></label>
        <input asp-for="EventTime" type="datetime-local" class="form-control" />
        <span asp-validation-for="EventTime" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Direction" class="form-label"></label>
        <select asp-for="Direction" class="form-select">
            <option value="@((int)PunchDirection.Undefined)">غير محدد</option>
            <option value="@((int)PunchDirection.CheckIn)">دخول</option>
            <option value="@((int)PunchDirection.CheckOut)">خروج</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Note" class="form-label"></label>
        <textarea asp-for="Note" class="form-control" rows="3" placeholder="سبب أو توضيح السجل اليدوي (إلزامي)"></textarea>
        <span asp-validation-for="Note" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">حفظ السجل</button>
    <a asp-controller="Attendance" asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
