@model Hikvision.Web.ViewModels.Reports.StatisticsViewModel
@{
    ViewData["Title"] = "الإحصائيات والمؤشرات";

    var topAbsent = Model.Employees.Where(e => e.DaysAbsent > 0)
        .OrderByDescending(e => e.AbsenceRate).ThenByDescending(e => e.DaysAbsent).Take(10).ToList();
    var topLate = Model.Employees.Where(e => e.LateCount > 0)
        .OrderByDescending(e => e.TotalLateMinutes).Take(10).ToList();
    var topPresent = Model.Employees
        .OrderByDescending(e => e.PresenceRate).ThenBy(e => e.DaysAbsent).Take(10).ToList();

    void StatCard(string label, string value, string soft, string icon)
    {
        <div class="col-lg-3 col-md-4 col-6">
            <div class="card stat-card">
                <div class="stat-icon @soft"><i class="bi @icon"></i></div>
                <div>
                    <div class="stat-label">@label</div>
                    <div class="stat-value">@value</div>
                </div>
            </div>
        </div>
    }

    string RateClass(decimal absenceRate) =>
        absenceRate >= 25 ? "text-danger fw-bold" : absenceRate >= 10 ? "text-warning" : "";
}

<div class="print-only print-header">
    <h3>تقرير الإحصائيات والمؤشرات</h3>
    <p>الفترة: @Model.From.ToString("yyyy-MM-dd") — @Model.To.ToString("yyyy-MM-dd") · عدد الموظفين: @Model.Kpis.EmployeeCount · متوسط نسبة الحضور: @Model.Kpis.AvgPresenceRate%</p>
</div>

<h2 class="mb-3">الإحصائيات والمؤشرات</h2>

<form method="get" class="row g-2 align-items-end mb-3 card card-body">
    <div class="col-md-3">
        <label class="form-label">المجموعة</label>
        <select name="groupId" asp-items="ViewBag.Groups" class="form-select">
            <option value="">كل المجموعات</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">من شهر</label>
        <input type="month" name="fromMonth" value="@Model.From.ToString("yyyy-MM")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">إلى شهر</label>
        <input type="month" name="toMonth" value="@Model.To.ToString("yyyy-MM")" class="form-control" />
    </div>
    <div class="col-md-5">
        <button type="submit" class="btn btn-primary">عرض</button>
        <a class="btn btn-outline-success"
           asp-action="ExportStatsCsv" asp-route-groupId="@Model.GroupId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"><i class="bi bi-filetype-csv"></i> CSV</a>
        <a class="btn btn-outline-success"
           asp-action="ExportStatsXlsx" asp-route-groupId="@Model.GroupId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة</button>
    </div>
</form>

@* ===== المؤشرات العامة ===== *@
<div class="row g-3 mb-4">
    @{ StatCard("عدد الموظفين", Model.Kpis.EmployeeCount.ToString(), "bg-soft-primary", "bi-people"); }
    @{ StatCard("متوسط نسبة الحضور", $"{Model.Kpis.AvgPresenceRate}%", "bg-soft-success", "bi-check2-circle"); }
    @{ StatCard("إجمالي أيام الغياب", Model.Kpis.TotalAbsentDays.ToString(), "bg-soft-danger", "bi-x-circle"); }
    @{ StatCard("إجمالي دقائق التأخير", Model.Kpis.TotalLateMinutes.ToString(), "bg-soft-warning", "bi-alarm"); }
    @{ StatCard("إجازات مدفوعة", Model.Kpis.TotalLeaveDays.ToString(), "bg-soft-info", "bi-calendar-check"); }
    @{ StatCard("إجازة بدون مرتب", Model.Kpis.TotalUnpaidLeaveDays.ToString(), "bg-soft-secondary", "bi-calendar-minus"); }
    @{ StatCard("مهام العمل", Model.Kpis.TotalMissionDays.ToString(), "bg-soft-primary", "bi-briefcase"); }
    @{ StatCard("أذونات الخروج", Model.Kpis.TotalPermittedExits.ToString(), "bg-soft-info", "bi-door-open"); }
</div>

@* ===== الرسوم البيانية ===== *@
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-graph-up"></i> نسبة الحضور اليومي (%)</div>
            <div class="card-body"><canvas id="dailyChart" height="110"></canvas></div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-bar-chart"></i> الأعلى غيابًا (نسبة الغياب %)</div>
            <div class="card-body"><canvas id="absenceChart" height="150"></canvas></div>
        </div>
    </div>
</div>

@* ===== إحصائيات الموظفين ===== *@
<div class="card table-card mb-4">
    <div class="card-header"><i class="bi bi-people"></i> إحصائيات الموظفين (مرتّبة بالأعلى غيابًا)</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>الموظف</th>
                    <th>الرقم المالي</th>
                    <th>المجموعة</th>
                    <th>أيام الفترة</th>
                    <th>الحضور</th>
                    <th>الغياب</th>
                    <th>نسبة الحضور %</th>
                    <th>نسبة الغياب %</th>
                    <th>إجازات</th>
                    <th>بدون مرتب</th>
                    <th>مهام</th>
                    <th>أذونات</th>
                    <th>تأخير (مرات)</th>
                    <th>تأخير (دقائق)</th>
                    <th>ساعات العمل</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Employees)
                {
                    <tr>
                        <td>@r.FullName</td>
                        <td>@(string.IsNullOrEmpty(r.FinancialNo) ? "—" : r.FinancialNo)</td>
                        <td>@r.GroupName</td>
                        <td>@r.PeriodDays</td>
                        <td>@r.DaysPresent</td>
                        <td class="@RateClass(r.AbsenceRate)">@r.DaysAbsent</td>
                        <td>@r.PresenceRate</td>
                        <td class="@RateClass(r.AbsenceRate)">@r.AbsenceRate</td>
                        <td>@r.DaysLeave</td>
                        <td>@r.DaysUnpaidLeave</td>
                        <td>@r.WorkMissionDays</td>
                        <td>@r.PermittedExitCount</td>
                        <td>@r.LateCount</td>
                        <td>@r.TotalLateMinutes</td>
                        <td>@r.TotalWorkedHours</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ===== قوائم الأعلى ===== *@
<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card table-card h-100">
            <div class="card-header"><i class="bi bi-x-circle text-danger"></i> الأكثر غيابًا (Top 10)</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>الموظف</th><th>غياب</th><th>%</th></tr></thead>
                    <tbody>
                        @foreach (var r in topAbsent)
                        {
                            <tr><td>@r.FullName</td><td>@r.DaysAbsent</td><td class="@RateClass(r.AbsenceRate)">@r.AbsenceRate</td></tr>
                        }
                        @if (topAbsent.Count == 0) { <tr><td colspan="3" class="text-muted">لا يوجد</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card table-card h-100">
            <div class="card-header"><i class="bi bi-alarm text-warning"></i> الأكثر تأخرًا (Top 10)</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>الموظف</th><th>مرات</th><th>دقائق</th></tr></thead>
                    <tbody>
                        @foreach (var r in topLate)
                        {
                            <tr><td>@r.FullName</td><td>@r.LateCount</td><td>@r.TotalLateMinutes</td></tr>
                        }
                        @if (topLate.Count == 0) { <tr><td colspan="3" class="text-muted">لا يوجد</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card table-card h-100">
            <div class="card-header"><i class="bi bi-award text-success"></i> الأكثر انضباطًا (Top 10)</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>الموظف</th><th>حضور</th><th>%</th></tr></thead>
                    <tbody>
                        @foreach (var r in topPresent)
                        {
                            <tr><td>@r.FullName</td><td>@r.DaysPresent</td><td>@r.PresenceRate</td></tr>
                        }
                        @if (topPresent.Count == 0) { <tr><td colspan="3" class="text-muted">لا يوجد</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ===== ملخص المجموعات ===== *@
<div class="card table-card mb-4" style="max-width:900px;">
    <div class="card-header"><i class="bi bi-diagram-3"></i> ملخص المجموعات</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>المجموعة</th><th>عدد الموظفين</th><th>متوسط نسبة الحضور %</th>
                    <th>إجمالي الغياب</th><th>مرات التأخير</th><th>دقائق التأخير</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.Groups)
                {
                    <tr>
                        <td>@g.GroupName</td><td>@g.EmployeeCount</td><td>@g.AvgPresenceRate</td>
                        <td>@g.TotalAbsentDays</td><td>@g.TotalLateCount</td><td>@g.TotalLateMinutes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ===== الحضور اليومي ===== *@
<div class="card table-card mb-4" style="max-width:900px;">
    <div class="card-header"><i class="bi bi-calendar3"></i> الحضور اليومي</div>
    <div class="table-responsive" style="max-height:420px;overflow:auto">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>التاريخ</th><th>اليوم</th><th>حاضرون</th><th>غائبون</th>
                    <th>متأخرون</th><th>نسبة الحضور %</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Daily)
                {
                    <tr class="@(d.IsHoliday ? "table-info" : null)">
                        <td>@d.Date.ToString("yyyy-MM-dd") @(d.IsHoliday ? "🎉" : "")</td>
                        <td>@d.DayName</td>
                        <td>@d.Present</td>
                        <td>@d.Absent</td>
                        <td>@d.Late</td>
                        <td>@d.PresenceRate</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const ink = '#334155', grid = 'rgba(0,0,0,.06)', blue = '#2563eb';

            // نسبة الحضور اليومي — خط زمني (سلسلة واحدة، بلا وسيلة إيضاح)
            const daily = @Json.Serialize(Model.Daily.Select(d => new { date = d.Date.ToString("MM-dd"), rate = d.PresenceRate }));
            new Chart(document.getElementById('dailyChart'), {
                type: 'line',
                data: {
                    labels: daily.map(d => d.date),
                    datasets: [{
                        data: daily.map(d => d.rate),
                        borderColor: blue,
                        backgroundColor: 'rgba(37,99,235,.08)',
                        borderWidth: 2,
                        pointRadius: 2,
                        pointHoverRadius: 5,
                        fill: true,
                        tension: .2
                    }]
                },
                options: {
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.parsed.y + '%' } } },
                    scales: {
                        y: { min: 0, max: 100, ticks: { color: ink }, grid: { color: grid } },
                        x: { ticks: { color: ink, maxTicksLimit: 15 }, grid: { display: false } }
                    }
                }
            });

            // الأعلى غيابًا — أعمدة أفقية بلون واحد (مقدار واحد لكل موظف)
            const topAbs = @Json.Serialize(topAbsent.Select(e => new { name = e.FullName, rate = e.AbsenceRate }));
            new Chart(document.getElementById('absenceChart'), {
                type: 'bar',
                data: {
                    labels: topAbs.map(e => e.name),
                    datasets: [{
                        data: topAbs.map(e => e.rate),
                        backgroundColor: blue,
                        borderRadius: 4,
                        maxBarThickness: 18
                    }]
                },
                options: {
                    indexAxis: 'y',
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.parsed.x + '%' } } },
                    scales: {
                        x: { min: 0, max: 100, ticks: { color: ink }, grid: { color: grid } },
                        y: { ticks: { color: ink }, grid: { display: false } }
                    }
                }
            });
        })();
    </script>
}
