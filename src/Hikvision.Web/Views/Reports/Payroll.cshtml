@model Hikvision.Web.ViewModels.Reports.PayrollReportViewModel
@{
    ViewData["Title"] = "تقرير المرتبات";
}
<h2 class="mb-3">تقرير الحضور والمرتبات</h2>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label">المجموعة</label>
        <select name="groupId" asp-items="ViewBag.Groups" class="form-select">
            <option value="">كل المجموعات</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">من تاريخ</label>
        <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">إلى تاريخ</label>
        <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">عرض</button>
        <a class="btn btn-outline-success"
           asp-action="ExportCsv" asp-route-groupId="@Model.GroupId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">CSV</a>
        <a class="btn btn-outline-success"
           asp-action="ExportXlsx" asp-route-groupId="@Model.GroupId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">Excel</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>الموظف</th>
            <th>المجموعة</th>
            <th>أيام الحضور</th>
            <th>أيام الغياب</th>
            <th>أيام الإجازة</th>
            <th>أيام مهام العمل</th>
            <th>أذونات الخروج المبكر</th>
            <th>أيام العطل</th>
            <th>مرات التأخير</th>
            <th>دقائق التأخير</th>
            <th>إجمالي ساعات العمل</th>
            <th>الراتب الأساسي</th>
            <th>تقدير الصرف</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.FullName</td>
                <td>@r.GroupName</td>
                <td>@r.DaysPresent</td>
                <td>@r.DaysAbsent</td>
                <td>@r.DaysLeave</td>
                <td>@r.WorkMissionDays</td>
                <td>@r.EarlyExitPermissionCount</td>
                <td>@r.HolidayDays</td>
                <td>@r.LateCount</td>
                <td>@r.TotalLateMinutes</td>
                <td>@r.TotalWorkedHours</td>
                <td>@(r.BaseSalary?.ToString("N2") ?? "—")</td>
                <td>@(r.EstimatedPay?.ToString("N2") ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Rows.Any())
{
    <p class="text-muted">لا توجد بيانات للفترة المحددة.</p>
}
