@model Hikvision.Web.ViewModels.Reports.PayrollReportViewModel
@{
    ViewData["Title"] = "تقرير المرتبات";
}
<h2 class="mb-3">تقرير الحضور والمرتبات</h2>

<div class="print-only print-header">
    <h3>تقرير الحضور والمرتبات</h3>
    <p>الفترة: @Model.From.ToString("yyyy-MM-dd") — @Model.To.ToString("yyyy-MM-dd") · عدد الموظفين: @Model.Rows.Count</p>
</div>

<form method="get" class="row g-2 align-items-end mb-3 card card-body">
    <div class="col-md-3">
        <label class="form-label">المجموعة</label>
        <select name="groupId" asp-items="ViewBag.Groups" class="form-select">
            <option value="">كل المجموعات</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">من شهر</label>
        <input type="month" name="fromMonth" value="@Model.From.ToString("yyyy-MM")" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">إلى شهر</label>
        <input type="month" name="toMonth" value="@Model.To.ToString("yyyy-MM")" class="form-control" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">عرض</button>
        <a class="btn btn-outline-success"
           asp-action="ExportCsv" asp-route-groupId="@Model.GroupId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"><i class="bi bi-filetype-csv"></i> CSV</a>
        <a class="btn btn-outline-success"
           asp-action="ExportXlsx" asp-route-groupId="@Model.GroupId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة</button>
    </div>
</form>

<div class="card table-card">
<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead>
        <tr>
            <th>الموظف</th>
            <th>المجموعة</th>
            <th>أيام الحضور</th>
            <th>أيام الغياب</th>
            <th>أيام الإجازة</th>
            <th>إجازة بدون مرتب</th>
            <th>أيام مهام العمل</th>
            <th>أذونات الخروج المبكر</th>
            <th>أيام العطل</th>
            <th>مرات التأخير</th>
            <th>دقائق التأخير</th>
            <th>إجمالي ساعات العمل</th>
            <th>الراتب الأساسي</th>
            <th>تقدير الصرف</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.FullName</td>
                <td>@r.GroupName</td>
                <td>@r.DaysPresent</td>
                <td>@r.DaysAbsent</td>
                <td>@r.DaysLeave</td>
                <td>@r.DaysUnpaidLeave</td>
                <td>@r.WorkMissionDays</td>
                <td>@r.EarlyExitPermissionCount</td>
                <td>@r.HolidayDays</td>
                <td>@r.LateCount</td>
                <td>@r.TotalLateMinutes</td>
                <td>@r.TotalWorkedHours</td>
                <td>@(r.BaseSalary?.ToString("N2") ?? "—")</td>
                <td>@(r.EstimatedPay?.ToString("N2") ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
@if (!Model.Rows.Any())
{
    <p class="text-muted mt-2">لا توجد بيانات للفترة المحددة.</p>
}
