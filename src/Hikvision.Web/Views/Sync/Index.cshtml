@{
    ViewData["Title"] = "المزامنة مع الجهاز";
    var last = ViewBag.LastSync as SyncLog;
    var defFrom = (DateTime)ViewBag.DefaultFrom;
    var defTo = (DateTime)ViewBag.DefaultTo;
    var logFiles = ViewBag.LogFiles as List<string> ?? new List<string>();
    var scheduleEnabled = (bool)(ViewBag.ScheduleEnabled ?? true);
    var scheduleTime = ViewBag.ScheduleTime as string ?? "14:30";
}

<div class="alert @(scheduleEnabled ? "alert-info" : "alert-secondary") d-flex align-items-center gap-2">
    <i class="bi bi-clock"></i>
    @if (scheduleEnabled)
    {
        <span>المزامنة الآلية مفعّلة يوميًا عند الساعة <strong>@scheduleTime</strong>. وإذا كان التطبيق متوقفًا عند الموعد، تُنفَّذ تلقائيًا عند تشغيله لاحقًا.</span>
    }
    else
    {
        <span>المزامنة الآلية معطّلة. يمكن تفعيلها من إعداد <code>Sync:Enabled</code>.</span>
    }
</div>
<h2 class="mb-3">المزامنة مع الجهاز</h2>

<div class="card shadow-sm mb-4" style="max-width:650px;">
    <div class="card-body">
        <form asp-action="Run" method="post" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">من</label>
                <input type="datetime-local" name="from" value="@defFrom.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
            </div>
            <div class="col-md-5">
                <label class="form-label">إلى</label>
                <input type="datetime-local" name="to" value="@defTo.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">مزامنة الآن</button>
            </div>
        </form>
        <div class="form-text mt-2">تُسحب بصمات الحضور من الجهاز عبر ISAPI وتُضاف السجلات الجديدة فقط (يُتخطى المكرر).</div>
    </div>
</div>

<div class="card shadow-sm mb-4 border-danger" style="max-width:650px;">
    <div class="card-body">
        <h6 class="card-title text-danger">حذف سجلات الجهاز وإعادة الضبط</h6>
        <p class="form-text mb-3">
            يحذف جميع سجلات الحضور الآتية من البصمة فقط ويُصفّر علامة آخر مزامنة لإعادة السحب من جديد.
            <strong>تبقى السجلات اليدوية والموظفون كما هم.</strong>
            بعد الحذف حدّد حقل "من" بتاريخ قديم مناسب ثم اضغط "مزامنة الآن" لإعادة سحب كامل التاريخ.
        </p>
        <form asp-action="PurgeDevice" method="post"
              onsubmit="return confirm('سيتم حذف جميع سجلات الحضور الآتية من الجهاز نهائيًا (تبقى السجلات اليدوية والموظفون). ثم أعد المزامنة. هل أنت متأكد؟');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">🗑 حذف سجلات الجهاز وإعادة الضبط</button>
        </form>
    </div>
</div>

<h5>آخر عملية مزامنة</h5>
@if (last is null)
{
    <p class="text-muted">لم تُجرَ أي مزامنة بعد.</p>
}
else
{
    <table class="table table-bordered" style="max-width:650px;">
        <tr><th>الحالة</th><td>@(last.Success ? "نجحت" : "فشلت")</td></tr>
        <tr><th>الفترة</th><td>@last.FromTime.ToString("yyyy-MM-dd HH:mm") — @last.ToTime.ToString("yyyy-MM-dd HH:mm")</td></tr>
        <tr><th>مسحوب</th><td>@last.FetchedCount</td></tr>
        <tr><th>مُدخل</th><td>@last.InsertedCount</td></tr>
        <tr><th>مكرر (تم تخطيه)</th><td>@last.SkippedDuplicateCount</td></tr>
        <tr><th>غير مطابَق</th><td>@last.UnmatchedEmployeeCount</td></tr>
        @if (!last.Success && last.ErrorMessage is not null)
        {
            <tr><th>الخطأ</th><td class="text-danger">@last.ErrorMessage</td></tr>
        }
    </table>
}

<h5 class="mt-4">ملفات السجل</h5>
<p class="text-muted mb-2">
    <code>unmatched-*</code>: أرقام أجهزة غير مسجّلة كموظفين.
    <code>noperson-*</code>: أحداث بلا شخص (فتح باب/أزرار/حساسات/محاولات فاشلة) مع تصنيف نوعها.
</p>
@if (logFiles.Count == 0)
{
    <p class="text-muted">لا توجد ملفات بعد. تُنشأ الملفات تلقائيًا عند وجود مثل هذه الأحداث في المزامنة.</p>
}
else
{
    <ul class="list-group" style="max-width:650px;">
        @foreach (var f in logFiles)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@f</span>
                <a class="btn btn-sm btn-outline-success" asp-action="DownloadLog" asp-route-name="@f">تنزيل CSV</a>
            </li>
        }
    </ul>
    <small class="text-muted">الملفات محفوظة في مجلد <code>logs</code> داخل المشروع.</small>
}
