@model IEnumerable<AttendanceRecord>
@inject Hikvision.Web.Services.Auth.IPermissionService Perms
@{
    ViewData["Title"] = "سجلات الحضور";
    var canDeleteRec = await Perms.HasAsync(AppModule.Attendance, PermAction.Delete);
    var canManualEntry = await Perms.HasAsync(AppModule.ManualAttendance, PermAction.View);

    string DirText(PunchDirection d) => d switch
    {
        PunchDirection.CheckIn => "دخول",
        PunchDirection.CheckOut => "خروج",
        PunchDirection.BreakOut => "بداية استراحة",
        PunchDirection.BreakIn => "نهاية استراحة",
        _ => "—"
    };
    string ManualText(ManualAttendanceType t) => t switch
    {
        ManualAttendanceType.WorkMission => "مهمة عمل",
        ManualAttendanceType.Leave => "إجازة",
        ManualAttendanceType.UnpaidLeave => "إجازة بدون مرتب",
        ManualAttendanceType.PermittedExit => "خروج بإذن",
        ManualAttendanceType.TaskDone => "إنجاز عمل",
        ManualAttendanceType.Exemption => "إعفاء",
        _ => "—"
    };
    var fEmp = (int?)ViewBag.EmployeeId;
    var fFrom = (DateOnly?)ViewBag.From;
    var fTo = (DateOnly?)ViewBag.To;
    var fSrc = ((object?)ViewBag.Source)?.ToString();
    var hasManual = Model.Any(r => r.Source == AttendanceSource.Manual);
}

<div class="print-only print-header">
    <h3>سجلات الحضور</h3>
    <p>
        @if (ViewBag.EmployeeName is string empName) { <text>الموظف: @empName · </text> }
        الفترة: @(fFrom?.ToString("yyyy-MM-dd")) — @(fTo?.ToString("yyyy-MM-dd")) · عدد السجلات: @Model.Count()
    </p>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>سجلات الحضور</h2>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة</button>
        @if (canDeleteRec && hasManual)
        {
            <form asp-action="DeleteManualFiltered" method="post" class="d-inline"
                  onsubmit="return confirm('سيتم حذف كل السجلات اليدوية ضمن التصفية الحالية نهائيًا. متابعة؟');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="employeeId" value="@fEmp" />
                <input type="hidden" name="from" value="@(fFrom?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="to" value="@(fTo?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="source" value="@fSrc" />
                <button type="submit" class="btn btn-outline-danger">🗑 حذف السجلات اليدوية (حسب التصفية)</button>
            </form>
        }
        @if (canManualEntry)
        {
            <a asp-controller="ManualAttendance" asp-action="Create" class="btn btn-success">+ إدخال يدوي</a>
        }
    </div>
</div>

<form method="get" class="row g-2 align-items-end mb-3 card card-body">
    <div class="col-md-3">
        <label class="form-label">الموظف</label>
        <select name="employeeId" asp-items="ViewBag.Employees" class="form-select">
            <option value="">الكل</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">من</label>
        <input type="date" name="from" value="@(((DateOnly?)ViewBag.From)?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">إلى</label>
        <input type="date" name="to" value="@(((DateOnly?)ViewBag.To)?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">المصدر</label>
        @{ var srcStr = ((object?)ViewBag.Source)?.ToString(); }
        <select name="source" class="form-select">
            <option value="">الكل</option>
            <option value="Device" selected="@(srcStr == "Device")">جهاز</option>
            <option value="Manual" selected="@(srcStr == "Manual")">يدوي</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">تصفية</button>
    </div>
</form>

<div class="card table-card">
<div class="table-responsive">
<table class="table table-sm table-hover align-middle mb-0">
    <thead>
        <tr>
            <th>الموظف</th>
            <th>الوقت</th>
            <th>المصدر</th>
            <th>الاتجاه</th>
            <th>النوع اليدوي</th>
            <th>ملاحظة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Employee?.FullName</td>
                <td>@r.EventTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (r.Source == AttendanceSource.Manual)
                    {
                        <span class="badge badge-manual">يدوي</span>
                    }
                    else
                    {
                        <span class="badge badge-device">جهاز</span>
                    }
                </td>
                <td>@DirText(r.Direction)</td>
                <td>@(r.Source == AttendanceSource.Manual ? ManualText(r.ManualType) : "—")</td>
                <td>@r.Note</td>
                <td class="page-actions">
                    @if (canDeleteRec && r.Source == AttendanceSource.Manual)
                    {
                        <form asp-action="DeleteManual" method="post" class="d-inline"
                              onsubmit="return confirm('تأكيد حذف هذا السجل اليدوي؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <input type="hidden" name="employeeId" value="@fEmp" />
                            <input type="hidden" name="from" value="@(fFrom?.ToString("yyyy-MM-dd"))" />
                            <input type="hidden" name="to" value="@(fTo?.ToString("yyyy-MM-dd"))" />
                            <input type="hidden" name="source" value="@fSrc" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
@if (!Model.Any())
{
    <p class="text-muted mt-2">لا توجد سجلات ضمن المعايير المحددة.</p>
}
