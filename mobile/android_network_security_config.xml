<?xml version="1.0" encoding="utf-8"?>
<!--
  انسخ هذا الملف إلى:
  mobile/android/app/src/main/res/xml/network_security_config.xml

  يسمح باتصال HTTP العادي (cleartext) مع خادم الوزارة الداخلي على الشبكات الخاصة.
-->
<network-security-config>
    <!-- السماح بـ HTTP لكل النطاقات (الخادم داخلي على الشبكة المحلية فقط) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
